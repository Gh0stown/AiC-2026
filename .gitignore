# ---- catkin 编译产物 (clone 后自己 catkin_make) ----
/build/
/devel/
/logs/
*.pyc
__pycache__/

# ---- Python 虚拟环境 (视觉/深度学习依赖, 体积大, clone 后自己建) ----
# 重建步骤见 docs/vision_env.md
/.venv/
__pycache__/
*.egg-info/

# ---- 运行期缓存 (HyperLPR3 模型 / ultralytics 配置, 体积大) ----
/.cache/

# ---- 数据集与训练产物 (体积大, 不入库) ----
/datasets/
/runs/
*.pt
*.onnx
*.pth
# 但允许提交推理用的权重
!/weights/**
!**/weights/**

# 例外: ultralytics 第一次训练会做 AMP 自检, 自动下载这个文件到 weights/。
# 它不是本项目的推理权重, 别跟着 commit 进来 (必须写在上面两条放行规则之后才生效)。
/weights/yolo26n.pt

# ---- 临时验证目录 (我调试用的, 不入库) ----
.verify/
*.orig
*.rej

# ---- 到点拍摄的原始图片 (每次跑一个子文件夹, 体积大, 不入库) ----
/captures/

# ---- 编辑器/系统 ----
.vscode/
.idea/
*.swp
*~
.DS_Store
