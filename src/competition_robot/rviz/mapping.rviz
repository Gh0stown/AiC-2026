Panels:
  - Class: rviz/Displays
    Name: Displays
    Tree Height: 640
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 100; 100; 100
      Alpha: 0.3
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
    - Class: rviz/PointCloud2
      Enabled: false
      Name: Lidar3D_filtered
      Topic: /points_filtered
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Decay Time: 0
    - Class: rviz/PointCloud
      Enabled: false
      Name: Lidar3D_raw
      Topic: /points
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Decay Time: 0
    - Class: rviz/LaserScan
      Enabled: true
      Name: LaserScan
      Topic: /scan
      Style: Points
      Size (Pixels): 3
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz/Image
      Enabled: true
      Name: CameraRGB
      Topic: /camera/rgb/image_raw
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 6.0
      Enable Stereo Rendering: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: TopDown
      Near Clip Distance: 0.01
      Pitch: 1.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
