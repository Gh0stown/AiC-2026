<?xml version="1.0"?>
<sdf version="1.7">
  <model name="standee_c04">
    <!-- 人偶立牌: 高 0.150 m x 宽 0.070 m x 厚 0.003 m
         尺寸来源: ~/复赛资料/人员/ (用户确认 15x5 cm) -->
    <static>true</static>
    <link name="link">
      <visual name="board">
        <pose>0 0 0.0790 0 0 0</pose>
        <geometry><box><size>0.0030 0.0703 0.1500</size></box></geometry>
        <material>
          <script>
            <uri>model://standee_c04/materials/scripts</uri>
            <uri>model://standee_c04/materials/textures</uri>
            <name>Standee/c04</name>
          </script>
        </material>
      </visual>
      <!-- ★ 背面挡板: Gazebo 的 box 会把贴图糊到**六个面**上, 于是从背后看
           也是(镜像的)人物图 —— 实物的模切立牌背面是纯色卡纸。不挡的话:
             1) 视觉模型可能学到"正反两面都是人", 与真机域不一致 (sim2real 断裂);
             2) 从背后拍到的图会被误判成"正视目标".
           这里紧贴板背面加一块略大的纯色薄板, 从后面看就是纯色。 -->
      <visual name="back">
        <pose>-0.0020 0 0.0790 0 0 0</pose>
        <geometry><box><size>0.0010 0.0723 0.1520</size></box></geometry>
        <material><ambient>0.90 0.89 0.86 1</ambient><diffuse>0.90 0.89 0.86 1</diffuse></material>
      </visual>
      <visual name="base">
        <pose>0 0 0.0020 0 0 0</pose>
        <geometry><box><size>0.0450 0.0703 0.0040</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
      <collision name="col">
        <pose>0 0 0.0790 0 0 0</pose>
        <geometry><box><size>0.0030 0.0703 0.1500</size></box></geometry>
      </collision>
      <collision name="base_c">
        <pose>0 0 0.0020 0 0 0</pose>
        <geometry><box><size>0.0450 0.0703 0.0040</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
