<?xml version="1.0"?>
<sdf version="1.7">
  <model name="car_1">
    <!-- 车辆立牌 + 车牌 (苏A·B8Q62)
         车板 0.345 x 0.250 x 0.005 m (官方 34.5 x 25 cm x 5mm)
         车牌 0.095 x 0.030 m (官方 9.5 x 3 cm), 贴在正面后保险杠中间 -->
    <static>true</static>
    <link name="link">
      <visual name="body">
        <pose>0 0 0.1310 0 0 0</pose>
        <geometry><box><size>0.0050 0.3450 0.2500</size></box></geometry>
        <material><script>
          <uri>model://car_1/materials/scripts</uri>
          <uri>model://car_1/materials/textures</uri>
          <name>Car/Body_car_1</name>
        </script></material>
      </visual>
      <visual name="plate">
        <pose>0.0040 0 0.0540 0 0 0</pose>
        <geometry><box><size>0.0030 0.0950 0.0300</size></box></geometry>
        <material><script>
          <uri>model://car_1/materials/scripts</uri>
          <uri>model://car_1/materials/textures</uri>
          <name>Car/Plate_car_1</name>
        </script></material>
      </visual>
      <visual name="base">
        <pose>0 0 0.0030 0 0 0</pose>
        <geometry><box><size>0.060 0.3450 0.0060</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
      <collision name="col">
        <pose>0 0 0.1310 0 0 0</pose>
        <geometry><box><size>0.0050 0.3450 0.2500</size></box></geometry>
      </collision>
      <collision name="base_c">
        <pose>0 0 0.0030 0 0 0</pose>
        <geometry><box><size>0.060 0.3450 0.0060</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
