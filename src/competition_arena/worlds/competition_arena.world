<?xml version="1.0" ?>
<!--
  4.2 m x 4.2 m 比赛场地  (auto-generated by scripts/build_arena.py)
  场地外沿尺寸 : 4.400 x 4.400 m
  墙体高度     : 0.300 m
  墙体厚度     : 由原图线条宽度决定 (约 24.0 mm)
  墙体模式     : 仅外沿围墙
  地面贴图     : 原图裁剪, 逆时针预旋转 90 deg 以匹配 Gazebo 的 box UV
  坐标系       : 场地中心为原点, +x 向右, +y 向上 (俯视), z=0 为地面
-->
<sdf version="1.6">
  <world name="competition_arena">

    <include><uri>model://sun</uri></include>

    <!-- ================= 场地地面 (使用比赛地图贴图) ================= -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.01000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.400 4.400 0.0200</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e10</kp><kd>1</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.400 4.400 0.0200</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/arena.material</uri>
              <name>Arena/Floor</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= 场地四周 (场地外的大地面, 压低 2mm 避免与场地贴图 z-fighting) ================= -->
    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 -0.002 0 0 0</pose>
    </include>

    <!-- ================= 墙体 ================= -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="wall_00">
          <pose>-0.000000 2.189289 0.150000 0 0 0</pose>
          <geometry><box><size>4.399182 0.020605 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_00">
          <pose>-0.000000 2.189289 0.150000 0 0 0</pose>
          <geometry><box><size>4.399182 0.020605 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="wall_01">
          <pose>-0.000000 -2.187572 0.150000 0 0 0</pose>
          <geometry><box><size>4.399182 0.024039 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_01">
          <pose>-0.000000 -2.187572 0.150000 0 0 0</pose>
          <geometry><box><size>4.399182 0.024039 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="wall_02">
          <pose>-2.187572 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.399182 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_02">
          <pose>-2.187572 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.399182 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="wall_03">
          <pose>2.187572 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.399182 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_03">
          <pose>2.187572 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.399182 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

                  <!-- ===== 人物立牌 (tools/setup_standees.py 生成) ===== -->
    <include>
      <uri>model://standee_c01</uri>
      <name>A_north_1</name>
      <pose>-1.1942 1.4360 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://standee_c02</uri>
      <name>A_north_2</name>
      <pose>0.5652 1.4360 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://standee_c03</uri>
      <name>A_south_1</name>
      <pose>-1.1942 0.8790 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://standee_c04</uri>
      <name>A_south_2</name>
      <pose>0.5652 0.8790 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://standee_c05</uri>
      <name>A_west_1</name>
      <pose>-1.4400 0.9270 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://standee_F1</uri>
      <name>A_west_2</name>
      <pose>-1.4400 1.3880 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://standee_c06</uri>
      <name>B_north_1</name>
      <pose>-1.3468 0.1650 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://standee_c07</uri>
      <name>B_north_2</name>
      <pose>-0.5352 0.1650 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://standee_c08</uri>
      <name>B_east_1</name>
      <pose>-0.4390 -0.4489 0 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://standee_F2</uri>
      <name>B_east_2</name>
      <pose>-0.4390 0.1089 0 0 0 0.0000</pose>
    </include>
    <!-- ===== 人物立牌结束 ===== -->
      <!-- ===== 临时红绿灯 (tools/setup_traffic_lights.py 生成) ===== -->
    <include>
      <uri>model://traffic_light_h</uri>
      <name>tl_top</name>
      <pose>-0.5060 1.7790 0.0020 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://traffic_light_h</uri>
      <name>tl_bot</name>
      <pose>-0.1100 -1.2800 0.0020 0 0 1.5708</pose>
    </include>
    <!-- ===== 红绿灯结束 ===== -->
                <!-- ===== 车辆+车牌 (tools/setup_cars.py 生成) ===== -->
    <include>
      <uri>model://car_1</uri>
      <name>car_1_p</name>
      <pose>2.0560 -0.5010 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://car_2</uri>
      <name>car_2_p</name>
      <pose>2.0560 -1.1245 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://car_3</uri>
      <name>car_3_p</name>
      <pose>2.0560 -1.7620 0 0 0 3.1416</pose>
    </include>
    <!-- ===== 车辆+车牌结束 ===== -->
  </world>
</sdf>
