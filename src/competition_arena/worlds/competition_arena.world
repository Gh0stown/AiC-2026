<?xml version="1.0" ?>
<!--
  4.2 m x 4.2 m 比赛场地  (auto-generated by scripts/build_arena.py)
  场地外沿尺寸 : 4.200 x 4.200 m
  墙体高度     : 0.500 m
  墙体厚度     : 由原图线条宽度决定 (约 24.0 mm)
  墙体模式     : 仅外沿围墙
  地面贴图     : 原图裁剪, 逆时针预旋转 90 deg 以匹配 Gazebo 的 box UV
  坐标系       : 场地中心为原点, +x 向右, +y 向上 (俯视), z=0 为地面
-->
<sdf version="1.6">
  <world name="competition_arena">

    <include><uri>model://sun</uri></include>

    <!-- ================= 场地地面 (使用比赛地图贴图) ================= -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.01000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.200 4.200 0.0200</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e10</kp><kd>1</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.200 4.200 0.0200</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/arena.material</uri>
              <name>Arena/Floor</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= 场地四周 (场地外的大地面, 压低 2mm 避免与场地贴图 z-fighting) ================= -->
    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 -0.002 0 0 0</pose>
    </include>

    <!-- ================= 墙体 ================= -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="wall_00">
          <pose>0.000000 2.089697 0.150000 0 0 0</pose>
          <geometry><box><size>4.200000 0.020605 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_00">
          <pose>0.000000 2.089697 0.150000 0 0 0</pose>
          <geometry><box><size>4.200000 0.020605 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="wall_01">
          <pose>0.000000 -2.087980 0.150000 0 0 0</pose>
          <geometry><box><size>4.200000 0.024039 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_01">
          <pose>0.000000 -2.087980 0.150000 0 0 0</pose>
          <geometry><box><size>4.200000 0.024039 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="wall_02">
          <pose>-2.087980 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.200000 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_02">
          <pose>-2.087980 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.200000 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="wall_03">
          <pose>2.087980 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.200000 0.300000</size></box></geometry>
        </collision>
        <visual name="wall_03">
          <pose>2.087980 0.000000 0.150000 0 0 0</pose>
          <geometry><box><size>0.024039 4.200000 0.300000</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

                <!-- ===== 临时红绿灯 (tools/setup_traffic_lights.py 生成) ===== -->
    <include>
      <uri>model://traffic_light_h_single</uri>
      <name>tl_top</name>
      <pose>-0.1500 2.0000 0.0000 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://traffic_light_h</uri>
      <name>tl_bot</name>
      <pose>-0.1200 -2.0000 0.0000 0 0 1.5708</pose>
    </include>
    <!-- ===== 红绿灯结束 ===== -->
  </world>
</sdf>
